FROM postgres:17-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends awscli jq ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/qodynex-backup.sh /usr/local/bin/qodynex-backup
RUN chmod 0755 /usr/local/bin/qodynex-backup

ENTRYPOINT ["/usr/local/bin/qodynex-backup"]
